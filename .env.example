# Copia este archivo como .env  (cp .env.example .env). El .env NUNCA se sube al repositorio.

# --- Base de datos (PostgreSQL) ---
POSTGRES_USER=canchaya
POSTGRES_PASSWORD=canchaya
POSTGRES_DB=canchaya

# --- Backend ---
PORT=3000
# Dentro de docker-compose el host de la base de datos es "db"; fuera de Docker usa localhost.
DATABASE_URL=postgres://canchaya:canchaya@db:5432/canchaya
# CAMBIAR en cualquier ambiente real: mínimo 32 caracteres aleatorios.
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio-de-32-caracteres
JWT_EXPIRES_IN=2h
CORS_ORIGIN=http://localhost:5173
# URL pública del frontend; se usa en los enlaces de los correos (verificación y recuperación).
APP_URL=http://localhost:5173
NODE_ENV=development

# --- Seguridad ---
# Costo de bcrypt (RNF-01). 12 en producción; las pruebas usan 4 para ir rápido.
BCRYPT_ROUNDS=12
# Número de proxies de confianza delante del backend (balanceador con HTTPS). 0 si no hay.
TRUST_PROXY=0

# --- Correo (HT-07) ---
# Sin SMTP_HOST, en desarrollo los correos se escriben en el log (ahí aparecen los enlaces de verificación).
# En producción SMTP_HOST es obligatorio.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CanchaYa <no-responder@canchaya.local>
