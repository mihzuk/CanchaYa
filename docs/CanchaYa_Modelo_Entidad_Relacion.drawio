        <mxCell id="lg_notes" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#374151;strokeColor=none;fillColor=none;" value="&lt;b&gt;Decisiones de diseño&lt;/b&gt;&lt;br&gt;• Las &lt;b&gt;franjas horarias no se guardan&lt;/b&gt;: se calculan con HorarioAtencion − Reserva − BloqueoHorario (HU-07, HU-10).&lt;br&gt;• &lt;b&gt;RN-01&lt;/b&gt; (sin cruces) se garantiza en BD con restricción de exclusión o transacción con bloqueo (RNF-05).&lt;br&gt;• &lt;b&gt;RN-04&lt;/b&gt;: el precio se copia a Reserva.precio_total al confirmar.&lt;br&gt;• Promedios (estrellas, fair play) se calculan, no se almacenan." vertex="1">
          <mxGeometry height="133" width="276" x="-258" y="629" as="geometry" />
        </mxCell>
